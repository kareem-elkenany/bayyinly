<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green"
    android:fitsSystemWindows="false"
    tools:context=".ui.home.HomeFragment"
    tools:ignore="HardcodedText,ContentDescription,PrivateResource">

    <ImageView
        android:id="@+id/ivMosqueBackground"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:scaleType="centerCrop"
        android:alpha="0.1"
        app:tint="@color/dark_green_tint"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/ic_mosque" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvAskAi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="24dp"
        app:cardBackgroundColor="@color/white_transparent"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/white_semi"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_ai"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ask_ai"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/llCurrentPrayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="110dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/next_prayer"
            android:textColor="@color/text_label_on_green"
            android:textSize="14sp"
            android:letterSpacing="0.1"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvPrayerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Asr"
            android:textColor="@color/white"
            android:textSize="56sp"
            android:textStyle="bold"
            android:layout_marginTop="-4dp"/>

        <TextView
            android:id="@+id/tvPrayerTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3:45 PM"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:alpha="0.9" />

        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="- 01:23:45"
            android:textColor="@color/amber"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginTop="12dp"
            android:background="@color/white_transparent"
            android:paddingHorizontal="24dp"
            android:paddingVertical="8dp"/>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvDashboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/beige"
        app:shapeAppearanceOverlay="@style/TopRoundedCorners"
        app:cardElevation="24dp"
        app:layout_constraintTop_toBottomOf="@id/llCurrentPrayer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="280dp"
                android:paddingHorizontal="24dp"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/tvTimelineTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/today_timeline"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/llTimeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTimelineTitle">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="5">
                        <TextView android:id="@+id/tvTimelineFajr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Fajr\n4:30" android:gravity="center" android:textColor="@color/text_tertiary" android:textSize="10sp"/>
                        <TextView android:id="@+id/tvTimelineDhuhr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Dhuhr\n12:15" android:gravity="center" android:textColor="@color/text_tertiary" android:textSize="10sp"/>
                        <TextView android:id="@+id/tvTimelineAsr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Asr\n15:45" android:gravity="center" android:textColor="@color/green" android:textStyle="bold" android:textSize="10sp"/>
                        <TextView android:id="@+id/tvTimelineMaghrib" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Maghrib\n18:02" android:gravity="center" android:textColor="@color/text_primary" android:textSize="10sp"/>
                        <TextView android:id="@+id/tvTimelineIsha" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Isha\n19:30" android:gravity="center" android:textColor="@color/text_primary" android:textSize="10sp"/>
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <ProgressBar
                            android:id="@+id/pbTimelineProgress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginHorizontal="30dp"
                            android:max="100"
                            android:progress="0"
                            android:progressBackgroundTint="@color/progress_track"
                            android:progressTint="@color/green" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="5">
                            <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"><com.google.android.material.card.MaterialCardView android:id="@+id/nodeFajr" android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="center" app:cardBackgroundColor="@color/text_tertiary" app:cardCornerRadius="6dp" app:cardElevation="0dp"/></FrameLayout>
                            <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"><com.google.android.material.card.MaterialCardView android:id="@+id/nodeDhuhr" android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="center" app:cardBackgroundColor="@color/text_tertiary" app:cardCornerRadius="6dp" app:cardElevation="0dp"/></FrameLayout>
                            <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"><com.google.android.material.card.MaterialCardView android:id="@+id/nodeAsr" android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center" app:cardBackgroundColor="@color/green" app:cardCornerRadius="8dp" app:cardElevation="0dp" app:strokeWidth="2dp" app:strokeColor="@color/white"/></FrameLayout>
                            <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"><com.google.android.material.card.MaterialCardView android:id="@+id/nodeMaghrib" android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="center" app:cardBackgroundColor="@color/text_primary" app:cardCornerRadius="6dp" app:cardElevation="0dp"/></FrameLayout>
                            <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"><com.google.android.material.card.MaterialCardView android:id="@+id/nodeIsha" android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="center" app:cardBackgroundColor="@color/text_primary" app:cardCornerRadius="6dp" app:cardElevation="0dp"/></FrameLayout>
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llStatsCards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/llTimeline">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cvKhatmaCard"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="24dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/khatma_progress"
                                android:textColor="@color/text_secondary"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvKhatmaPercentage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="0%"
                                android:textColor="@color/text_primary"
                                android:textSize="24sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:alpha="0.8"
                                android:text="@string/khatma_hold_to_reset"
                                android:textColor="@color/text_tertiary"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cvStreakCard"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:padding="12dp"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="24dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/streak"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvStreakDays"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="7 Days"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
