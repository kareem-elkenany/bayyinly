<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_warm"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/ivNotificationIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_mosque"
        android:layout_marginEnd="12dp"
        android:alpha="0.5"
        android:contentDescription="@string/notification_prayer_icon_description" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNotificationPrayerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="---"
            android:textColor="@color/text_near_black"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNotificationPrayerTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="@color/text_dark_gray"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvNotificationCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/overlay_dark"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:text="- 00:00:00"
        android:textColor="@color/deep_green"
        android:textSize="10sp"
        android:textStyle="bold"
        android:fontFamily="monospace" />

</LinearLayout>