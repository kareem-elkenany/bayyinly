<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F5F5F5">

    <TextView
        android:id="@+id/tvSurahNameTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        tools:text="1. Al-Fatiha (الفاتحة)"
        android:textColor="#1B5E20"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent" />


    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:padding="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/ic_arrow_back"
        app:tint="#1B5E20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Ayah Count (Smaller Font) -->
    <TextView
        android:id="@+id/tvAyahCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        tools:text="7 Ayahs"
        android:textColor="#666666"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvSurahNameTitle" />

    <!-- The list that will hold all the Ayahs -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewAyahs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAyahCount"
        tools:listitem="@layout/item_ayah" />


    <!-- The Minimalist Audio Control Panel -->
    <!-- The Compact Audio Mini-Player -->
    <androidx.cardview.widget.CardView
        android:id="@+id/audioControlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="36dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="#E8F5E9"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"> <!-- Squeezed vertical padding -->

            <!-- Reciter Selection -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RECITER"
                android:textColor="#1B5E20"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <Spinner
                android:id="@+id/spinnerReciter"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:backgroundTint="#1B5E20"
                android:theme="@style/ThemeOverlay.AppCompat.Light" />

            <!-- Ayah Range -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <!-- Start Ayah -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="FROM AYAH"
                        android:textColor="#1B5E20"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />
                    <Spinner
                        android:id="@+id/spinnerStartAyah"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:backgroundTint="#1B5E20"
                        android:theme="@style/ThemeOverlay.AppCompat.Light"/>
                </LinearLayout>

                <!-- Spacer between dropdowns -->
                <View
                    android:layout_width="12dp"
                    android:layout_height="match_parent" />

                <!-- End Ayah -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="TO AYAH"
                        android:textColor="#1B5E20"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />
                    <Spinner
                        android:id="@+id/spinnerEndAyah"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:backgroundTint="#1B5E20"
                        android:theme="@style/ThemeOverlay.AppCompat.Light"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Play Controls (Shrunk down) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnPreviousAyah"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_media_previous"
                    app:tint="#1B5E20"
                    android:background="?attr/selectableItemBackgroundBorderless"/>

                <ImageView
                    android:id="@+id/btnPlayPause"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="24dp"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_media_play"
                    app:tint="#1B5E20"
                    android:background="?attr/selectableItemBackgroundBorderless"/>

                <ImageView
                    android:id="@+id/btnNextAyah"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_media_next"
                    app:tint="#1B5E20"
                    android:background="?attr/selectableItemBackgroundBorderless"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>