<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header row: number badge + repeat count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAzkarNumber"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="1" />

        </LinearLayout>

        <!-- Arabic text -->
        <TextView
            android:id="@+id/tvAzkarArabicEntry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:lineSpacingMultiplier="1.6"
            android:textColor="@color/text_dark"
            android:textDirection="rtl"
            android:textSize="24sp"
            tools:text="سُبْحَانَ اللَّهِ وَبِحَمْدِهِ" />

        <!-- Transliteration (hidden when empty) -->
        <TextView
            android:id="@+id/tvAzkarTranslit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="Subhaan Allahi wa bihamdihi" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/divider" />

        <!-- Translation -->
        <TextView
            android:id="@+id/tvAzkarTranslationEntry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_dark_secondary"
            android:textSize="14sp"
            tools:text="Glory and praise be to Allah." />

        <!-- Source -->
        <TextView
            android:id="@+id/tvAzkarSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:textColor="@color/text_hint"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Bukhari 6042" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>