<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="#F0F0F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header row: number badge + repeat count -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvAzkarNumber"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_alignParentStart="true"
                tools:text="1" />

            <TextView
                android:id="@+id/tvAzkarRepeatCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:minWidth="42dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="#1B5E20"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="3x" />

        </RelativeLayout>

        <!-- Arabic text -->
        <TextView
            android:id="@+id/tvAzkarArabicEntry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:lineSpacingMultiplier="1.6"
            android:textColor="#1F2D1E"
            android:textDirection="rtl"
            android:textSize="24sp"
            tools:text="سُبْحَانَ اللَّهِ وَبِحَمْدِهِ" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#F5F5F5" />

        <!-- Translation -->
        <TextView
            android:id="@+id/tvAzkarTranslationEntry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="3dp"
            android:textColor="#3E4E3B"
            android:textSize="14sp"
            tools:text="Glory and praise be to Allah." />

        <!-- Source -->
        <TextView
            android:id="@+id/tvAzkarSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:textColor="#8D856F"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Bukhari 6042" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>