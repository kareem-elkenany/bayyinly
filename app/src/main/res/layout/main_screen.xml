<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green"
    tools:context=".ui.MainActivity">

    <!-- STREAMING_CHUNK: Mosque Vector Graphic Background -->
    <!-- Note: Replace @drawable/ic_mosque with your actual vector drawable -->
    <ImageView
        android:id="@+id/ivMosqueBackground"
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:scaleType="centerCrop"
        android:alpha="0.1"
        app:tint="#5C8754"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/ic_mosque"
        tools:ignore="ContentDescription" />

    <!-- STREAMING_CHUNK: Current Prayer Focus Section -->
    <LinearLayout
        android:id="@+id/llCurrentPrayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEXT PRAYER"
            android:textColor="#DDF0D7"
            android:textSize="14sp"
            android:letterSpacing="0.1"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvPrayerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Asr"
            android:textColor="#FFFFFF"
            android:textSize="64sp"
            android:textStyle="bold"
            android:layout_marginTop="-4dp"/>

        <TextView
            android:id="@+id/tvPrayerTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3:45 PM"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:alpha="0.9" />

        <!-- STREAMING_CHUNK: The Game Changer Countdown -->
        <!-- We use a custom background drawable here, e.g., shape with #33FFFFFF color and rounded corners -->
        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="- 01:23:45"
            android:textColor="#FFD54F"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginTop="16dp"
            android:background="#33FFFFFF"
            android:paddingHorizontal="24dp"
            android:paddingVertical="8dp"/>
    </LinearLayout>

    <!-- STREAMING_CHUNK: Beige Dashboard Area (Old Paper Color) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvDashboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="@color/beige"
        app:shapeAppearanceOverlay="@style/TopRoundedCorners"
        app:cardElevation="24dp"
        app:layout_constraintTop_toBottomOf="@id/llCurrentPrayer"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- STREAMING_CHUNK: Dashboard Content inside the Beige Sheet -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="24dp"
            android:paddingHorizontal="24dp">

            <TextView
                android:id="@+id/tvTimelineTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today's Timeline"
                android:textColor="#2D402B"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- STREAMING_CHUNK: Horizontal Timeline -->
            <!-- In a real app, this should be a RecyclerView. Mocked here with ScrollView for UI layout -->
            <HorizontalScrollView
                android:id="@+id/hsvTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none"
                app:layout_constraintTop_toBottomOf="@id/tvTimelineTitle">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="80dp">

                    <!-- Progress Line Background -->
                    <View
                        android:layout_width="400dp"
                        android:layout_height="4dp"
                        android:background="#D3CABA"
                        android:layout_centerVertical="true"
                        android:layout_marginTop="-10dp"/>

                    <!-- Timeline Items (Mock layout structure) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_centerVertical="true">

                        <!-- These would normally be RecyclerView items -->
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Fajr\n4:30 AM" android:gravity="center" android:textColor="#2D402B" android:textSize="12sp"/>
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Dhuhr\n12:15 PM" android:gravity="center" android:textColor="#2D402B" android:textSize="12sp"/>
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="ASR\n3:45 PM" android:gravity="center" android:textColor="#79AE6F" android:textStyle="bold" android:textSize="14sp"/>
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Maghrib\n6:02 PM" android:gravity="center" android:textColor="#2D402B" android:textSize="12sp"/>
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Isha\n7:30 PM" android:gravity="center" android:textColor="#2D402B" android:textSize="12sp"/>
                    </LinearLayout>
                </RelativeLayout>
            </HorizontalScrollView>

            <!-- STREAMING_CHUNK: Gamification Stats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:weightSum="2"
                app:layout_constraintTop_toBottomOf="@id/hsvTimeline">

                <!-- Score Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HASANAT" android:textSize="12sp" android:textStyle="bold" android:textColor="#5D6B5A"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1,240" android:textSize="28sp" android:textColor="#2D402B" android:textStyle="bold"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Streak Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STREAK" android:textSize="12sp" android:textStyle="bold" android:textColor="#5D6B5A"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7 Days" android:textSize="28sp" android:textColor="#2D402B" android:textStyle="bold"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- STREAMING_CHUNK: Bottom Navigation Implementation -->
    <!-- Added app:menu to link your specific navigation items -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:itemIconTint="#A39A8A"
        app:itemTextColor="#A39A8A"
        app:elevation="24dp"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>