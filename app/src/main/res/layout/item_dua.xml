<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="8dp"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="#E2D8BE"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/tvDuaCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dua_badge"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:textColor="#2D402B"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Success" />

        <TextView
            android:id="@+id/tvDuaTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#2D402B"
            android:textSize="19sp"
            android:textStyle="bold"
            tools:text="For ease and confidence" />

        <TextView
            android:id="@+id/tvArabicDua"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="serif"
            android:lineSpacingExtra="8dp"
            android:textAlignment="viewEnd"
            android:textColor="#1F2D1E"
            android:textDirection="rtl"
            android:textSize="25sp"
            tools:text="رَبِّ اشْرَحْ لِي صَدْرِي" />

        <TextView
            android:id="@+id/tvTransliteration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp"
            android:textColor="#5D6B5A"
            android:textSize="14sp"
            tools:text="Rabbi ishrah li sadri." />

        <TextView
            android:id="@+id/tvTranslation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="4dp"
            android:textColor="#3E4E3B"
            android:textSize="15sp"
            tools:text="My Lord, expand for me my chest." />

        <TextView
            android:id="@+id/tvSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#8D856F"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Qur'an 20:25-26" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
